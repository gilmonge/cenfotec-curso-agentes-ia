{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "analista": {
      "description": "Agente de análisis de vacíos de requerimientos para el proyecto Historias de Usuario.",
      "mode": "primary",
      "system": "{file:./agentes/analista/prompts/sistema.md}",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
