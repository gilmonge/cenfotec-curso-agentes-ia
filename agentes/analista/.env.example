# Solo valores de ejemplo, NO secretos reales
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL
# Opcionales. Vacíos usan provider opencode y el modelo predeterminado del servidor.
# Configurar ambos valores autoriza explícitamente ese provider/model aunque OpenCode informe costo positivo o no publique costo.
# OpenCode aún debe anunciar el modelo y marcarlo como habilitado.
OPENCODE_PROVIDER_ID=
OPENCODE_MODEL_ID=
ANALISTA_HOST=127.0.0.1
ANALISTA_PORT=8000
ANALISTA_REQUEST_TIMEOUT_SECONDS=90
ANALISTA_TURN_TIMEOUT_SECONDS=90
ANALISTA_MAX_TOOL_CALLS=4
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Feature 003 experimental. La clave se define en el entorno local; no la escribas
# en código, documentación, logs ni en el frontend. Este ejemplo no contiene claves.
# Índice denso convencional en AWS us-east-1; PineconeEmbeddings crea vectores de 1024 dimensiones.
# La métrica es cosine y el modelo de embeddings es multilingual-e5-large.
# Namespaces permitidos: glosario, estandares, checklist, hu_aprobadas, lecciones y codigo.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=historias-usuario
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=1024
PINECONE_METRIC=cosine
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
