# Solo valores de ejemplo, NO secretos reales
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL
# Opcionales. Vacíos usan provider opencode y el modelo predeterminado del servidor.
# Configurar ambos valores autoriza explícitamente ese provider/model aunque OpenCode informe costo positivo o no publique costo.
# OpenCode aún debe anunciar el modelo y marcarlo como habilitado.
OPENCODE_PROVIDER_ID=
OPENCODE_MODEL_ID=
ANALISTA_HOST=127.0.0.1
ANALISTA_PORT=8000
ANALISTA_REQUEST_TIMEOUT_SECONDS=90
ANALISTA_TURN_TIMEOUT_SECONDS=90
ANALISTA_MAX_TOOL_CALLS=4
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
