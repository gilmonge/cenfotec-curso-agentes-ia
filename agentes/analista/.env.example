# Solo valores de ejemplo, NO secretos reales
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL
# Opcional: ID visible en GET /api/model. Vacío usa el default solo si es opencode y su costo publicado es cero.
# Modelos con precio positivo o metadatos de costo ausentes se rechazan sin crear una sesión.
OPENCODE_MODEL_ID=
ANALISTA_HOST=127.0.0.1
ANALISTA_PORT=8000
ANALISTA_REQUEST_TIMEOUT_SECONDS=90
ANALISTA_TURN_TIMEOUT_SECONDS=90
ANALISTA_MAX_TOOL_CALLS=4
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
